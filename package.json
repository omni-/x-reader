{
  "name": "x-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Personal read-only X research MCP server using a dedicated local browser",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/cli.js tunnel",
    "test:search-live": "npm run build && node scripts/search-live.mjs",
    "browser:install": "playwright install chromium",
    "login": "node dist/cli.js login",
    "diagnostics": "node dist/cli.js diagnostics",
    "serve:http": "node dist/cli.js http",
    "serve:stdio": "node dist/cli.js stdio",
    "reset-profile": "node dist/cli.js reset-profile",
    "clear-cache": "node dist/cli.js clear-cache",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:live": "npm run build && node scripts/live-test.mjs",
    "test:rich-live": "npm run build && node scripts/rich-content-live.mjs",
    "check": "tsc --noEmit && prettier --check src tests scripts README.md VERIFICATION.md package.json tsconfig.json",
    "format": "prettier --write src tests scripts README.md VERIFICATION.md package.json tsconfig.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "playwright": "1.63.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.2",
    "typescript": "7.0.2"
  }
}
